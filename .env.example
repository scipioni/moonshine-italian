# Copy to .env and fill in private values. .env is git-ignored.

# Hugging Face access token. Required only for gated datasets
# (Mozilla Common Voice Italian). FLEURS and MLS are public.
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: Hugging Face hub cache override (defaults to data/hf-cache)
# HF_HOME=

# Local Common Voice Italian archive (tar.gz). mozilla-foundation/common_voice_*
# on HF returns 404 (repo removed); this points at a local CC0 download of the
# corpus (e.g. from mozilladatacollective.com). download.py extracts only the
# clips referenced by train/dev/test.tsv from it.
CV_ARCHIVE_PATH=
